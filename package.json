{
  "name": "tasuketejs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:api": "pnpm --filter @tasuketejs/docs api",
    "docs:dev": "pnpm --filter @tasuketejs/docs dev",
    "docs:build": "pnpm --filter @tasuketejs/docs build",
    "docs:preview": "pnpm --filter @tasuketejs/docs preview",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --max-warnings=0 --no-warn-ignored"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "^8.67.0"
  }
}
