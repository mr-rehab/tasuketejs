{
  "name": "@tasuketejs/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "typedoc && mv src/api/README.md src/api/index.md",
    "dev": "vitepress dev src",
    "build": "pnpm run api && vitepress build src",
    "preview": "vitepress preview src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.41"
  }
}
